# Server only. Never prefix these variables with VITE_.
# JSON service account credential, stored in Netlify environment variables.
FIREBASE_ADMIN_KEY=
FIREBASE_DATABASE_URL=https://sania-wardrobe-default-rtdb.firebaseio.com
SERPAPI_KEY=
# Optional. Without both values categorization uses keyword suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local emulator mode only:
# VITE_USE_EMULATORS=true

# Optional main shared room (public browser configuration, not a secret).
# Keep the actual room ID in ignored .env.local and Netlify build settings.
VITE_DEFAULT_ROOM_ID=
